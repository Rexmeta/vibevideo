rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Projects: each document has a `user_id` field that must match the
    // authenticated user. Users can only read/write/create/delete their own
    // projects. Composite query (user_id == uid, orderBy updated_at desc) is
    // satisfied by firestore.indexes.json.
    match /projects/{projectId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // Cross-tab generation leases and completed asset references. The parent
    // project remains the ownership boundary; a client cannot claim another
    // user's generation job.
    match /projects/{projectId}/generation_jobs/{jobId} {
      allow read, write: if isSignedIn()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.user_id == request.auth.uid;
    }

    // Per-user subcollections (e.g. context_packs) live under /users/{uid}/...
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Shared AI model catalog. Any signed-in user can read; writes are
    // restricted to admins identified server-side by an /admins/{uid}
    // document. (The client-side `vibe_admin_uids` localStorage list is
    // only a UI hint and is NOT trusted here.)
    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /ai_models/{modelId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin allowlist documents are managed out-of-band (Firebase console)
    // and only visible to the owning admin themselves.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Health-check ping used by storageService.firestoreHealthPing.
    // Authenticated only — unauthenticated requests are denied.
    match /__health__/{doc} {
      allow read: if isSignedIn();
    }

    // Default deny: anything not matched above is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
